From 68ca49059e42f57c36ef1b95763f32bf92286b2c Mon Sep 17 00:00:00 2001
From: John Rinehart <johnrichardrinehart@gmail.com>
Date: Thu, 29 Oct 2026 19:41:37 -0400
Subject: [PATCH] wifi: mt76: mt7925e: disable only registered NAPI instances
 on reset

mt7925e_mac_reset() calls napi_disable() for each RX completion
interrupt in the irq map. The MT7925 irq map sets wm2_complete_mask,
but the MT7925 DMA layout has no tx_done ring. Thus the driver does
not allocate q_rx[MT_RXQ_MCU_WA] and does not add its NAPI instance.

napi_disable() takes the netdev instance lock through n->dev. For a
NAPI instance that was not added, n->dev is NULL. The reset work then
causes a NULL pointer dereference at offsetof(struct net_device, lock):

  mt7925e 0000:c0:00.0: Message 0012000d (seq 4) timeout
  BUG: kernel NULL pointer dereference, address: 0000000000000aa8
  Workqueue: mt76 mt7925_mac_reset_work [mt7925_common]
  RIP: 0010:mutex_lock+0x1c/0x30
  Call Trace:
   napi_disable+0x1d/0x40
   mt7925e_mac_reset+0x315/0x3b0 [mt7925e]
   mt7925_mac_reset_work+0xb0/0x1f0 [mt7925_common]

The kworker stops with the reset half done. The device and RTNL users
then hang until a power cycle.

Disable the NAPI instance of each allocated RX queue, as the enable
path later in the same function does, and as mt7921e_mac_reset() does.
Then disable the TX NAPI instance, which the DMA init adds on all
chips.
---
 drivers/net/wireless/mediatek/mt76/mt7925/pci_mac.c | 13 ++++---------
 1 file changed, 4 insertions(+), 9 deletions(-)

diff --git a/drivers/net/wireless/mediatek/mt76/mt7925/pci_mac.c b/drivers/net/wireless/mediatek/mt76/mt7925/pci_mac.c
--- a/drivers/net/wireless/mediatek/mt76/mt7925/pci_mac.c
+++ b/drivers/net/wireless/mediatek/mt76/mt7925/pci_mac.c
@@ -70,7 +70,6 @@
 
 int mt7925e_mac_reset(struct mt792x_dev *dev)
 {
-	const struct mt792x_irq_map *irq_map = dev->irq_map;
 	int i, err;
 
 	mt792xe_mcu_drv_pmctrl(dev);
@@ -88,14 +87,10 @@
 	mt76_txq_schedule_all(&dev->mphy);
 
 	mt76_worker_disable(&dev->mt76.tx_worker);
-	if (irq_map->rx.data_complete_mask)
-		napi_disable(&dev->mt76.napi[MT_RXQ_MAIN]);
-	if (irq_map->rx.wm_complete_mask)
-		napi_disable(&dev->mt76.napi[MT_RXQ_MCU]);
-	if (irq_map->rx.wm2_complete_mask)
-		napi_disable(&dev->mt76.napi[MT_RXQ_MCU_WA]);
-	if (irq_map->tx.all_complete_mask)
-		napi_disable(&dev->mt76.tx_napi);
+	mt76_for_each_q_rx(&dev->mt76, i) {
+		napi_disable(&dev->mt76.napi[i]);
+	}
+	napi_disable(&dev->mt76.tx_napi);
 
 	mt7925_tx_token_put(dev);
 	idr_init(&dev->mt76.token);
