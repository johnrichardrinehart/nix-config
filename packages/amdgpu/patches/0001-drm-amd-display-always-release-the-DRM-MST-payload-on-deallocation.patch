From aeb512bb4b99fd6fcae5a2567b3f8611607dcddb Mon Sep 17 00:00:00 2001
From: John Rinehart <johnrichardrinehart@gmail.com>
Date: Mon, 16 Nov 2026 17:29:53 -0500
Subject: [PATCH] drm/amd/display: always release the DRM MST payload on
 deallocation

[Why]
deallocate_mst_payload() only calls
dm_helpers_dp_mst_update_mst_mgr_for_deallocation(), and so
drm_dp_remove_payload_part2(), when the link is still in MST mode and
its encoding is known. When the MST hub went away (link no longer
dc_connection_mst_branch) or link training failed (DP_UNKNOWN_ENCODING),
it returns or skips before that call. drm_dp_add_payload_part1() has
already counted the payload, though, and nothing else ever resets
mgr->payload_count or mgr->next_start_slot. The slots leak for the life
of the topology manager, and every later payload starts past the end of
the 63-slot table:

  | idx | port | vcpi | slots | pbn | ...
       1      8      1 64 - 94   891   DELL U2520D
       2      8      2 64 - 63     0   DELL U3225QE

The monitors then train the link but get no stream and stay in standby
until the driver is reloaded. Seen after resume from hibernation on a
USB4 DP tunnel whose DPRX negotiation failed: link 7 enable failed with
"Failure: unknown encoding format", the thunderbolt driver tore the
tunnel down, and replugging or reloading thunderbolt brought the links
back but not the pictures.

The kernel-doc of drm_dp_remove_payload_part2() says drivers must call
it whenever they remove a payload in their HW, independent of whether
the branch devices could be updated.

[How]
Skip only the HW table update and ACT poll when the encoding is
unknown, and always release the payload from the DRM MST manager.
Make the release a no-op for payloads part 1 never allocated
(vc_start_slot < 0) so a stream that never got slots is not released
twice.
---
 .../amd/display/amdgpu_dm/amdgpu_dm_helpers.c |  5 ++++
 .../gpu/drm/amd/display/dc/link/link_dpms.c   | 27 ++++++++++++-------
 2 files changed, 22 insertions(+), 10 deletions(-)

diff --git a/drivers/gpu/drm/amd/display/amdgpu_dm/amdgpu_dm_helpers.c b/drivers/gpu/drm/amd/display/amdgpu_dm/amdgpu_dm_helpers.c
index 3067ac5bb0cd..303ed5576678 100644
--- a/drivers/gpu/drm/amd/display/amdgpu_dm/amdgpu_dm_helpers.c
+++ b/drivers/gpu/drm/amd/display/amdgpu_dm/amdgpu_dm_helpers.c
@@ -524,6 +524,11 @@ void dm_helpers_dp_mst_update_mst_mgr_for_deallocation(
 	mst_mgr = &aconnector->mst_root->mst_mgr;
 	mst_state = to_drm_dp_mst_topology_state(mst_mgr->base.state);
 	new_payload = drm_atomic_get_mst_payload_state(mst_state, aconnector->mst_output_port);
+
+	/* Nothing to release if part 1 never ran or part 2 already did. */
+	if (!new_payload || new_payload->vc_start_slot < 0)
+		return;
+
 	dm_helpers_construct_old_payload(mst_mgr, mst_state,
 					 new_payload, &old_payload);
 
diff --git a/drivers/gpu/drm/amd/display/dc/link/link_dpms.c b/drivers/gpu/drm/amd/display/dc/link/link_dpms.c
index 75e232ebffe8..e6f99e2d10cd 100644
--- a/drivers/gpu/drm/amd/display/dc/link/link_dpms.c
+++ b/drivers/gpu/drm/amd/display/dc/link/link_dpms.c
@@ -1321,6 +1321,7 @@ static enum dc_status deallocate_mst_payload(struct pipe_ctx *pipe_ctx)
 	bool mst_mode = (link->type == dc_connection_mst_branch);
 	const struct link_hwss *link_hwss = get_link_hwss(link, &pipe_ctx->link_res);
 	const struct dc_link_settings empty_link_settings = {0};
+	enum dc_status status = DC_OK;
 	DC_LOGGER_INIT(link->ctx->logger);
 
 	/* deallocate_mst_payload is called before disable link. When mode or
@@ -1369,22 +1370,28 @@ static enum dc_status deallocate_mst_payload(struct pipe_ctx *pipe_ctx)
 	if (link_hwss->ext.update_stream_allocation_table == NULL ||
 			link_dp_get_encoding_format(&link->cur_link_settings) == DP_UNKNOWN_ENCODING) {
 		DC_LOG_DEBUG("Unknown encoding format\n");
-		return DC_ERROR_UNEXPECTED;
-	}
-
-	link_hwss->ext.update_stream_allocation_table(link, &pipe_ctx->link_res,
-			&link->mst_stream_alloc_table);
+		status = DC_ERROR_UNEXPECTED;
+	} else {
+		link_hwss->ext.update_stream_allocation_table(link, &pipe_ctx->link_res,
+				&link->mst_stream_alloc_table);
 
-	if (mst_mode)
-		dm_helpers_dp_mst_poll_for_allocation_change_trigger(
-			stream->ctx,
-			stream);
+		if (mst_mode)
+			dm_helpers_dp_mst_poll_for_allocation_change_trigger(
+				stream->ctx,
+				stream);
+	}
 
+	/* The stream no longer has a payload in DC, whether or not the
+	 * hardware table could be reprogrammed (link lost, link training
+	 * failed, or MST hub gone). Always release it from the DRM MST
+	 * manager too, otherwise its time slots stay counted and every
+	 * later payload on this manager starts past the end of the table.
+	 */
 	dm_helpers_dp_mst_update_mst_mgr_for_deallocation(
 			stream->ctx,
 			stream);
 
-	return DC_OK;
+	return status;
 }
 
 /* convert link_mst_stream_alloc_table to dm dp_mst_stream_alloc_table
-- 
2.56.1

