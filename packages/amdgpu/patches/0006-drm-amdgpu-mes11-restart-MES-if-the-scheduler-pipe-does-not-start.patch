From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
Subject: [PATCH] drm/amdgpu/mes11: restart MES if the scheduler pipe does not start

After some hibernation restores on GC 11.5.0 (Radeon 890M), the PSP
accepts all four MES firmware loads, but once the pipes are enabled the
scheduler pipe stays at instruction 1 and never reports its firmware
version, while the KIQ pipe runs. The KIQ ring test then times out,
amdgpu_device_ip_resume() fails with -110 and the GPU ends up wedged.

Wait up to 20 ms for the scheduler pipe to report its version after
enabling MES. If it does not, halt and reset the pipes (which also
invalidates the MES instruction cache) and enable them again, up to
three times.
---
diff --git a/drivers/gpu/drm/amd/amdgpu/mes_v11_0.c b/drivers/gpu/drm/amd/amdgpu/mes_v11_0.c
index 03ce792..299fd74 100644
--- a/drivers/gpu/drm/amd/amdgpu/mes_v11_0.c
+++ b/drivers/gpu/drm/amd/amdgpu/mes_v11_0.c
@@ -1933,9 +1933,27 @@ static void mes_v11_0_kiq_clear(struct amdgpu_device *adev)
 	WREG32_SOC15(GC, 0, regRLC_CP_SCHEDULERS, tmp);
 }
 
+/* Has the scheduler pipe reported its firmware version within 20 ms? */
+static bool mes_v11_0_sched_started(struct amdgpu_device *adev)
+{
+	u32 ver = 0;
+	int i;
+
+	for (i = 0; i < 200 && !ver; i++) {
+		mutex_lock(&adev->srbm_mutex);
+		soc21_grbm_select(adev, 3, AMDGPU_MES_SCHED_PIPE, 0, 0);
+		ver = RREG32_SOC15(GC, 0, regCP_MES_GP3_LO);
+		soc21_grbm_select(adev, 0, 0, 0, 0);
+		mutex_unlock(&adev->srbm_mutex);
+		if (!ver)
+			udelay(100);
+	}
+	return ver;
+}
+
 static int mes_v11_0_kiq_hw_init(struct amdgpu_device *adev, uint32_t xcc_id)
 {
-	int r = 0;
+	int r = 0, tries;
 	struct amdgpu_ip_block *ip_block;
 
 	if (adev->firmware.load_type == AMDGPU_FW_LOAD_DIRECT) {
@@ -1956,6 +1974,21 @@ static int mes_v11_0_kiq_hw_init(struct amdgpu_device *adev, uint32_t xcc_id)
 
 	mes_v11_0_enable(adev, true);
 
+	/*
+	 * After some hibernation restores the scheduler pipe never leaves
+	 * its first instruction although the PSP loaded its firmware: its
+	 * version register stays 0 while the KIQ pipe runs. Halt, reset and
+	 * re-enable the pipes, which also invalidates the instruction cache.
+	 */
+	for (tries = 0; tries < 3 && !mes_v11_0_sched_started(adev); tries++) {
+		dev_warn(adev->dev,
+			 "MES scheduler pipe did not start, restarting MES (%d)\n",
+			 tries + 1);
+		mes_v11_0_enable(adev, false);
+		udelay(50);
+		mes_v11_0_enable(adev, true);
+	}
+
 	/* Debug: is MES running once enabled? */
 	mes_v11_0_dump_state(adev, KERN_INFO, "enabled", &adev->mes.ring[0],
 			     0, 0);
