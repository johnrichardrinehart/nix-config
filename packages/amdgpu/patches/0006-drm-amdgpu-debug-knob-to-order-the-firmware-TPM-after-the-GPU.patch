From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
Subject: [PATCH] drm/amdgpu: debug knob to order the firmware TPM after the GPU in PM

Not for upstream. s4_tpm_link (runtime, default off) adds a stateless
device link with the firmware TPM (MSFT0101:00) as consumer of the GPU,
so the TPM suspends before amdgpu and resumes after it, with all other
devices still parallel. Tests whether the GFX 11.5 hibernation restore
failure comes from the TPM's PSP traffic overlapping amdgpu's.
---
diff --git a/drivers/gpu/drm/amd/amdgpu/amdgpu_drv.c b/drivers/gpu/drm/amd/amdgpu/amdgpu_drv.c
--- a/drivers/gpu/drm/amd/amdgpu/amdgpu_drv.c
+++ b/drivers/gpu/drm/amd/amdgpu/amdgpu_drv.c
@@ -2719,6 +2719,74 @@
 		 "Sleep this many ms before freezing for hibernation (default: 0)");
 
 /*
+ * s4_tpm_link: link the firmware TPM (ACPI MSFT0101:00) as a PM consumer of
+ * the GPU, so the PM core suspends the TPM before amdgpu and resumes it
+ * after, while every other device stays parallel. Both talk to the PSP.
+ * Writing 1 adds the link, 0 removes it; takes effect for the next sleep.
+ */
+static struct pci_driver amdgpu_kms_pci_driver;
+static struct device_link *amdgpu_s4_tpm_link;
+static DEFINE_MUTEX(amdgpu_s4_tpm_link_lock);
+
+static int amdgpu_s4_match_any(struct device *dev, const void *data)
+{
+	return 1;
+}
+
+static int amdgpu_s4_tpm_link_set(const char *val, const struct kernel_param *kp)
+{
+	struct device *gpu, *tpm;
+	bool on;
+	int r;
+
+	r = kstrtobool(val, &on);
+	if (r)
+		return r;
+
+	guard(mutex)(&amdgpu_s4_tpm_link_lock);
+	if (!on) {
+		if (amdgpu_s4_tpm_link) {
+			device_link_del(amdgpu_s4_tpm_link);
+			amdgpu_s4_tpm_link = NULL;
+			pr_info("amdgpu: s4_tpm_link removed\n");
+		}
+		return 0;
+	}
+	if (amdgpu_s4_tpm_link)
+		return 0;
+
+	gpu = driver_find_device(&amdgpu_kms_pci_driver.driver, NULL, NULL,
+				 amdgpu_s4_match_any);
+	if (!gpu)
+		return -ENODEV;
+	tpm = bus_find_device_by_name(&platform_bus_type, NULL, "MSFT0101:00");
+	if (!tpm) {
+		put_device(gpu);
+		return -ENODEV;
+	}
+	/* consumer = TPM, supplier = GPU: TPM suspends first, resumes last */
+	amdgpu_s4_tpm_link = device_link_add(tpm, gpu, DL_FLAG_STATELESS);
+	r = amdgpu_s4_tpm_link ? 0 : -EINVAL;
+	dev_info(gpu, "s4_tpm_link %s for %s\n", r ? "failed" : "added", dev_name(tpm));
+	put_device(tpm);
+	put_device(gpu);
+	return r;
+}
+
+static int amdgpu_s4_tpm_link_get(char *buf, const struct kernel_param *kp)
+{
+	return sysfs_emit(buf, "%d\n", amdgpu_s4_tpm_link ? 1 : 0);
+}
+
+static const struct kernel_param_ops amdgpu_s4_tpm_link_ops = {
+	.set = amdgpu_s4_tpm_link_set,
+	.get = amdgpu_s4_tpm_link_get,
+};
+module_param_cb(s4_tpm_link, &amdgpu_s4_tpm_link_ops, NULL, 0644);
+MODULE_PARM_DESC(s4_tpm_link,
+		 "Order the firmware TPM's suspend before and resume after the GPU (default: 0)");
+
+/*
  * On GFX 11.5 APUs MES intermittently fails to come back on restore from
  * hibernation when the GPU is frozen while other devices are still running
  * their freeze callbacks.  Do the freeze in the late phase for these parts,
