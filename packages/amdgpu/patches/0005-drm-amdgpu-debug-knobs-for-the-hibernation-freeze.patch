From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
Subject: [PATCH] drm/amdgpu: debug knobs for the hibernation freeze

Not for upstream. Runtime module parameters s4_tpm_serialize (turns the
TPM lock off for A/B runs) and s4_freeze_delay_ms, plus log markers for
freeze start, PG/CG ungate and freeze done.
---

diff --git a/drivers/gpu/drm/amd/amdgpu/amdgpu_drv.c b/drivers/gpu/drm/amd/amdgpu/amdgpu_drv.c
--- a/drivers/gpu/drm/amd/amdgpu/amdgpu_drv.c
+++ b/drivers/gpu/drm/amd/amdgpu/amdgpu_drv.c
@@ -2715,10 +2715,26 @@
  * command reaches the PSP in parallel with amdgpu's PSP traffic.  Other
  * devices keep freezing and resuming in parallel.
  */
+/*
+ * Debug knobs for the GFX 11.5 hibernation failure, writable at runtime
+ * between pm_test cycles.  Set them before a transition, not during one.
+ */
+static bool amdgpu_s4_tpm_serialize = true;
+module_param_named(s4_tpm_serialize, amdgpu_s4_tpm_serialize, bool, 0644);
+MODULE_PARM_DESC(s4_tpm_serialize,
+		 "Hold the firmware TPM's lock across hibernation freeze/restore (default: true)");
+
+static unsigned int amdgpu_s4_freeze_delay_ms;
+module_param_named(s4_freeze_delay_ms, amdgpu_s4_freeze_delay_ms, uint, 0644);
+MODULE_PARM_DESC(s4_freeze_delay_ms,
+		 "Sleep this many ms before freezing for hibernation (default: 0)");
+
 static struct tpm_chip *amdgpu_pm_tpm_lock(struct amdgpu_device *adev)
 {
 	struct tpm_chip *chip;
 
+	if (!amdgpu_s4_tpm_serialize)
+		return NULL;
 	if (!IS_REACHABLE(CONFIG_TCG_TPM) || !(adev->flags & AMD_IS_APU))
 		return NULL;
 
@@ -2743,8 +2759,13 @@
 	struct tpm_chip *tpm;
 	int r;
 
+	if (amdgpu_s4_freeze_delay_ms)
+		msleep(amdgpu_s4_freeze_delay_ms);
+
 	tpm = amdgpu_pm_tpm_lock(adev);
+	dev_info(adev->dev, "S4 freeze start (TPM lock %s)\n", tpm ? "held" : "not held");
 	r = amdgpu_device_suspend(drm_dev, true);
+	dev_info(adev->dev, "S4 freeze done: %d\n", r);
 	if (!r && amdgpu_acpi_should_gpu_reset(adev)) {
 		amdgpu_device_lock_reset_domain(adev->reset_domain);
 		r = amdgpu_asic_reset(adev);
diff --git a/drivers/gpu/drm/amd/amdgpu/amdgpu_device.c b/drivers/gpu/drm/amd/amdgpu/amdgpu_device.c
--- a/drivers/gpu/drm/amd/amdgpu/amdgpu_device.c
+++ b/drivers/gpu/drm/amd/amdgpu/amdgpu_device.c
@@ -3046,6 +3046,8 @@
 
 	amdgpu_device_set_pg_state(adev, AMD_PG_STATE_UNGATE);
 	amdgpu_device_set_cg_state(adev, AMD_CG_STATE_UNGATE);
+	if (adev->in_s4)
+		dev_info(adev->dev, "S4 freeze: PG/CG ungated\n");
 
 	/*
 	 * Per PMFW team's suggestion, driver needs to handle gfxoff
