From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
Subject: [PATCH] drm/amdgpu/mes11: debug MES start-up after hibernation restore

Debug patch, not for upstream as is. After some hibernation restores on
GC 11.5.0 the MES pipes are enabled but never execute: the KIQ ring test
or SET_HW_RSRC times out with both instruction pointers at 0.
Log the PSP's answer to each MES firmware load and the MES pipe state
right after the pipes are enabled, and on a MES or KIQ timeout dump the
MES control register, pipe instruction pointers, GP0-GP3, ring and
fence state, the PSP mailbox registers, and the KIQ poll time by each
clock. With amdgpu.mes_log_enable=1, also keep a copy of the MES event
log and scratch area taken at the first hang, in debugfs as
amdgpu_mes_event_log_hang.
---
diff --git a/drivers/gpu/drm/amd/amdgpu/amdgpu_mes.c b/drivers/gpu/drm/amd/amdgpu/amdgpu_mes.c
index 1a86a47..4877a96 100644
--- a/drivers/gpu/drm/amd/amdgpu/amdgpu_mes.c
+++ b/drivers/gpu/drm/amd/amdgpu/amdgpu_mes.c
@@ -21,6 +21,7 @@
  *
  */
 
+#include <linux/debugfs.h>
 #include <linux/firmware.h>
 #include <drm/drm_exec.h>
 
@@ -1157,15 +1158,42 @@ DEFINE_SHOW_ATTRIBUTE(amdgpu_debugfs_mes_event_log);
 
 #endif
 
+/*
+ * Debug: a copy of the whole MES event log and scratch area, taken at the
+ * first MES hang of this boot, before recovery touches MES again. Read it
+ * from debugfs as amdgpu_mes_event_log_hang (raw bytes).
+ */
+static struct debugfs_blob_wrapper amdgpu_mes_hang_log;
+
+void amdgpu_mes_event_log_snapshot(struct amdgpu_device *adev, const char *why)
+{
+	void *copy;
+
+	if (!amdgpu_mes_log_enable || !adev->mes.event_log_cpu_addr ||
+	    READ_ONCE(amdgpu_mes_hang_log.data))
+		return;
+	copy = kvmalloc(adev->mes.event_log_size, GFP_KERNEL);
+	if (!copy)
+		return;
+	memcpy(copy, adev->mes.event_log_cpu_addr, adev->mes.event_log_size);
+	amdgpu_mes_hang_log.size = adev->mes.event_log_size;
+	smp_store_release(&amdgpu_mes_hang_log.data, copy);
+	dev_err(adev->dev, "MES event log snapshot taken (%s, %u bytes)\n",
+		why, adev->mes.event_log_size);
+}
+
 void amdgpu_debugfs_mes_event_log_init(struct amdgpu_device *adev)
 {
 
 #if defined(CONFIG_DEBUG_FS)
 	struct drm_minor *minor = adev_to_drm(adev)->primary;
 	struct dentry *root = minor->debugfs_root;
-	if (adev->enable_mes && amdgpu_mes_log_enable)
+	if (adev->enable_mes && amdgpu_mes_log_enable) {
 		debugfs_create_file("amdgpu_mes_event_log", 0444, root,
 				    adev, &amdgpu_debugfs_mes_event_log_fops);
+		debugfs_create_blob("amdgpu_mes_event_log_hang", 0400, root,
+				    &amdgpu_mes_hang_log);
+	}
 
 #endif
 }
diff --git a/drivers/gpu/drm/amd/amdgpu/amdgpu_mes.h b/drivers/gpu/drm/amd/amdgpu/amdgpu_mes.h
index 977c057..1a080c5 100644
--- a/drivers/gpu/drm/amd/amdgpu/amdgpu_mes.h
+++ b/drivers/gpu/drm/amd/amdgpu/amdgpu_mes.h
@@ -643,4 +643,6 @@ int amdgpu_mes_alloc_gang_ctx_index(struct amdgpu_mes *mes,
 				    uint32_t *index);
 void amdgpu_mes_free_gang_ctx_index(struct amdgpu_mes *mes,
 				    uint32_t index);
+void amdgpu_mes_event_log_snapshot(struct amdgpu_device *adev, const char *why);
+
 #endif /* __AMDGPU_MES_H__ */
diff --git a/drivers/gpu/drm/amd/amdgpu/amdgpu_psp.c b/drivers/gpu/drm/amd/amdgpu/amdgpu_psp.c
index 42adc8e..1563ed7 100644
--- a/drivers/gpu/drm/amd/amdgpu/amdgpu_psp.c
+++ b/drivers/gpu/drm/amd/amdgpu/amdgpu_psp.c
@@ -3401,6 +3401,14 @@ int psp_execute_ip_fw_load(struct psp_context *psp,
 					 psp->fence_buf_mc_addr);
 	}
 
+	/* Debug: the PSP's answer to each MES firmware load. */
+	if (ucode->ucode_id >= AMDGPU_UCODE_ID_CP_MES &&
+	    ucode->ucode_id <= AMDGPU_UCODE_ID_CP_MES1_DATA)
+		dev_info(psp->adev->dev,
+			 "PSP load %s: ret=%d status=%08x mc=%llx size=%u\n",
+			 amdgpu_ucode_name(ucode->ucode_id), ret,
+			 cmd->resp.status, ucode->mc_addr, ucode->ucode_size);
+
 	release_psp_cmd_buf(psp);
 
 	return ret;
diff --git a/drivers/gpu/drm/amd/amdgpu/gfx_v11_0.c b/drivers/gpu/drm/amd/amdgpu/gfx_v11_0.c
index 7a006b2..193c216 100644
--- a/drivers/gpu/drm/amd/amdgpu/gfx_v11_0.c
+++ b/drivers/gpu/drm/amd/amdgpu/gfx_v11_0.c
@@ -21,6 +21,7 @@
  *
  */
 #include <linux/delay.h>
+#include <linux/sched/clock.h>
 #include <linux/kernel.h>
 #include <linux/firmware.h>
 #include <linux/module.h>
@@ -583,6 +584,9 @@ static int gfx_v11_0_ring_test_ring(struct amdgpu_ring *ring)
 	struct amdgpu_device *adev = ring->adev;
 	uint32_t scratch = SOC15_REG_OFFSET(GC, 0, regSCRATCH_REG0);
 	uint32_t tmp = 0;
+	u64 t0_mono, t0_raw, t0_local;
+	unsigned long j0;
+	int cpu0;
 	unsigned i;
 	int r;
 
@@ -604,6 +608,11 @@ static int gfx_v11_0_ring_test_ring(struct amdgpu_ring *ring)
 	}
 	amdgpu_ring_commit(ring);
 
+	t0_mono = ktime_get_ns();
+	t0_raw = ktime_get_raw_ns();
+	t0_local = local_clock();
+	j0 = jiffies;
+	cpu0 = raw_smp_processor_id();
 	for (i = 0; i < adev->usec_timeout; i++) {
 		tmp = RREG32(scratch);
 		if (tmp == 0xDEADBEEF)
@@ -614,8 +623,18 @@ static int gfx_v11_0_ring_test_ring(struct amdgpu_ring *ring)
 			udelay(1);
 	}
 
-	if (i >= adev->usec_timeout)
+	if (i >= adev->usec_timeout) {
 		r = -ETIMEDOUT;
+		/* Debug: how long the poll really took, by every clock. */
+		drm_err(adev_to_drm(adev),
+			"ring %s test: %u polls, scratch=%08x, elapsed mono=%llu raw=%llu local=%llu ns jiffies=%lu cpu %d->%d\n",
+			ring->name, i, tmp, ktime_get_ns() - t0_mono,
+			ktime_get_raw_ns() - t0_raw, local_clock() - t0_local,
+			jiffies - j0, cpu0, raw_smp_processor_id());
+		if (adev->enable_mes)
+			mes_v11_0_dump_state(adev, KERN_ERR, "hang",
+					     &adev->mes.ring[0], 0, 0);
+	}
 	return r;
 }
 
diff --git a/drivers/gpu/drm/amd/amdgpu/mes_v11_0.c b/drivers/gpu/drm/amd/amdgpu/mes_v11_0.c
index 10bed6f..870428f 100644
--- a/drivers/gpu/drm/amd/amdgpu/mes_v11_0.c
+++ b/drivers/gpu/drm/amd/amdgpu/mes_v11_0.c
@@ -31,7 +31,9 @@
 #include "gc/gc_11_0_0_sh_mask.h"
 #include "gc/gc_11_0_0_default.h"
 #include "v11_structs.h"
+#include "mes_v11_0.h"
 #include "mes_v11_api_def.h"
+#include "mp/mp_13_0_2_offset.h"
 
 MODULE_FIRMWARE("amdgpu/gc_11_0_0_mes.bin");
 MODULE_FIRMWARE("amdgpu/gc_11_0_0_mes_2.bin");
@@ -173,6 +175,62 @@ static const char *mes_v11_0_get_misc_op_string(union MESAPI__MISC *x_pkt)
 	return op_str;
 }
 
+/*
+ * Debug: on a MES timeout, show whether the MES pipes run (two samples of
+ * each pipe's instruction pointer), what they report in GP0-GP3, how far
+ * the MES ring got, and the PSP mailbox state, so a hang after hibernation
+ * restore can be told apart from a MES that never started.
+ */
+void mes_v11_0_dump_state(struct amdgpu_device *adev, const char *level,
+			  const char *why, struct amdgpu_ring *ring, u32 seq,
+			  u64 status)
+{
+	u32 ip[AMDGPU_MAX_MES_PIPES][2], gp[AMDGPU_MAX_MES_PIPES][4];
+	u32 cntl = RREG32_SOC15(GC, 0, regCP_MES_CNTL);
+	bool sel = mutex_trylock(&adev->srbm_mutex);
+	int pipe, i;
+
+	memset(ip, 0xff, sizeof(ip));
+	memset(gp, 0xff, sizeof(gp));
+	if (sel) {
+		for (i = 0; i < 2; i++) {
+			for (pipe = 0; pipe < AMDGPU_MAX_MES_PIPES; pipe++) {
+				soc21_grbm_select(adev, 3, pipe, 0, 0);
+				ip[pipe][i] = RREG32_SOC15(GC, 0, regCP_MES_INSTR_PNTR);
+				if (i)
+					continue;
+				gp[pipe][0] = RREG32_SOC15(GC, 0, regCP_MES_GP0_LO);
+				gp[pipe][1] = RREG32_SOC15(GC, 0, regCP_MES_GP1_LO);
+				gp[pipe][2] = RREG32_SOC15(GC, 0, regCP_MES_GP2_LO);
+				gp[pipe][3] = RREG32_SOC15(GC, 0, regCP_MES_GP3_LO);
+			}
+			soc21_grbm_select(adev, 0, 0, 0, 0);
+			udelay(20);
+		}
+		mutex_unlock(&adev->srbm_mutex);
+	}
+
+	if (!strcmp(why, "hang"))
+		amdgpu_mes_event_log_snapshot(adev, why);
+	dev_printk(level, adev->dev, "MES %s: CP_MES_CNTL=%08x srbm=%d\n", why, cntl, sel);
+	for (pipe = 0; pipe < AMDGPU_MAX_MES_PIPES; pipe++)
+		dev_printk(level, adev->dev,
+			"MES %s: pipe%d IP=%08x,%08x GP0-3=%08x %08x %08x %08x\n",
+			why, pipe, ip[pipe][0], ip[pipe][1], gp[pipe][0], gp[pipe][1],
+			gp[pipe][2], gp[pipe][3]);
+	dev_printk(level, adev->dev,
+		"MES %s: ring rptr=%llx wptr=%llx fence=%u seq=%u api_status=%llx ready=%d\n",
+		why, amdgpu_ring_get_rptr(ring), ring->wptr,
+		le32_to_cpu(*ring->fence_drv.cpu_addr), seq, status,
+		ring->sched.ready);
+	dev_printk(level, adev->dev,
+		"MES %s: PSP C2PMSG_33=%08x 35=%08x 64=%08x 81=%08x\n",
+		why, RREG32_SOC15(MP0, 0, regMP0_SMN_C2PMSG_33),
+		RREG32_SOC15(MP0, 0, regMP0_SMN_C2PMSG_35),
+		RREG32_SOC15(MP0, 0, regMP0_SMN_C2PMSG_64),
+		RREG32_SOC15(MP0, 0, regMP0_SMN_C2PMSG_81));
+}
+
 static int mes_v11_0_submit_pkt_and_poll_completion(struct amdgpu_mes *mes,
 						    void *pkt, int size,
 						    int api_status_off)
@@ -268,6 +326,7 @@ static int mes_v11_0_submit_pkt_and_poll_completion(struct amdgpu_mes *mes,
 			dev_err(adev->dev, "MES failed to respond to msg=%d\n",
 				x_pkt->header.opcode);
 
+		mes_v11_0_dump_state(adev, KERN_ERR, "hang", ring, seq, *status_ptr);
 		while (halt_if_hws_hang)
 			schedule();
 
@@ -1899,6 +1958,10 @@ static int mes_v11_0_kiq_hw_init(struct amdgpu_device *adev, uint32_t xcc_id)
 
 	mes_v11_0_enable(adev, true);
 
+	/* Debug: is MES running once enabled? */
+	mes_v11_0_dump_state(adev, KERN_INFO, "enabled", &adev->mes.ring[0],
+			     0, 0);
+
 	mes_v11_0_get_fw_version(adev);
 
 	mes_v11_0_kiq_setting(&adev->gfx.kiq[0].ring);
diff --git a/drivers/gpu/drm/amd/amdgpu/mes_v11_0.h b/drivers/gpu/drm/amd/amdgpu/mes_v11_0.h
index b3519e1..300d2b0 100644
--- a/drivers/gpu/drm/amd/amdgpu/mes_v11_0.h
+++ b/drivers/gpu/drm/amd/amdgpu/mes_v11_0.h
@@ -26,4 +26,9 @@
 
 extern const struct amdgpu_ip_block_version mes_v11_0_ip_block;
 
+struct amdgpu_ring;
+void mes_v11_0_dump_state(struct amdgpu_device *adev, const char *level,
+			  const char *why, struct amdgpu_ring *ring, u32 seq,
+			  u64 status);
+
 #endif
