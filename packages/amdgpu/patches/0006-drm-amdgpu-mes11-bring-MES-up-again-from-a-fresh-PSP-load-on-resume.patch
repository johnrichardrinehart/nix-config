From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
Subject: [PATCH] drm/amdgpu/mes11: bring MES up again from a fresh PSP load on resume

After some hibernation restores on GC 11.5.0 (Radeon 890M), the PSP
accepts all four MES firmware loads, but one MES pipe ends up parked at
instruction 0 or 1: either the scheduler pipe never starts and never
reports its firmware version, or the KIQ pipe starts and then stops
before its ring test. The KIQ ring test or SET_HW_RSRC then times out,
amdgpu_device_ip_resume() fails with -110, and the GPU is left wedged
after a mode-2 reset.

During resume, wait up to 20 ms for the scheduler pipe to report its
version after MES is enabled. If it does not, or bringing MES up times
out later, halt the pipes, reset the KIQ ring, load the MES firmware
again through the PSP and start over, up to three times.
---
diff --git a/drivers/gpu/drm/amd/amdgpu/mes_v11_0.c b/drivers/gpu/drm/amd/amdgpu/mes_v11_0.c
index 03ce792..b98bb32 100644
--- a/drivers/gpu/drm/amd/amdgpu/mes_v11_0.c
+++ b/drivers/gpu/drm/amd/amdgpu/mes_v11_0.c
@@ -1933,7 +1933,25 @@ static void mes_v11_0_kiq_clear(struct amdgpu_device *adev)
 	WREG32_SOC15(GC, 0, regRLC_CP_SCHEDULERS, tmp);
 }
 
-static int mes_v11_0_kiq_hw_init(struct amdgpu_device *adev, uint32_t xcc_id)
+/* Has the scheduler pipe reported its firmware version within 20 ms? */
+static bool mes_v11_0_sched_started(struct amdgpu_device *adev)
+{
+	u32 ver = 0;
+	int i;
+
+	for (i = 0; i < 200 && !ver; i++) {
+		mutex_lock(&adev->srbm_mutex);
+		soc21_grbm_select(adev, 3, AMDGPU_MES_SCHED_PIPE, 0, 0);
+		ver = RREG32_SOC15(GC, 0, regCP_MES_GP3_LO);
+		soc21_grbm_select(adev, 0, 0, 0, 0);
+		mutex_unlock(&adev->srbm_mutex);
+		if (!ver)
+			udelay(100);
+	}
+	return ver;
+}
+
+static int mes_v11_0_kiq_start(struct amdgpu_device *adev)
 {
 	int r = 0;
 	struct amdgpu_ip_block *ip_block;
@@ -1960,6 +1978,11 @@ static int mes_v11_0_kiq_hw_init(struct amdgpu_device *adev, uint32_t xcc_id)
 	mes_v11_0_dump_state(adev, KERN_INFO, "enabled", &adev->mes.ring[0],
 			     0, 0);
 
+	if (!mes_v11_0_sched_started(adev)) {
+		dev_warn(adev->dev, "MES scheduler pipe did not start\n");
+		return -ETIMEDOUT;
+	}
+
 	mes_v11_0_get_fw_version(adev);
 
 	mes_v11_0_kiq_setting(&adev->gfx.kiq[0].ring);
@@ -1992,6 +2015,61 @@ static int mes_v11_0_kiq_hw_init(struct amdgpu_device *adev, uint32_t xcc_id)
 	return r;
 }
 
+/* Load the MES firmware again through the PSP, with the pipes halted. */
+static int mes_v11_0_psp_reload(struct amdgpu_device *adev)
+{
+	static const enum AMDGPU_UCODE_ID ids[] = {
+		AMDGPU_UCODE_ID_CP_MES, AMDGPU_UCODE_ID_CP_MES_DATA,
+		AMDGPU_UCODE_ID_CP_MES1, AMDGPU_UCODE_ID_CP_MES1_DATA,
+	};
+	int i, r;
+
+	for (i = 0; i < ARRAY_SIZE(ids); i++) {
+		struct amdgpu_firmware_info *ucode = &adev->firmware.ucode[ids[i]];
+
+		if (!ucode->fw || !ucode->ucode_size)
+			continue;
+		r = psp_execute_ip_fw_load(&adev->psp, ucode);
+		if (r)
+			return r;
+	}
+	return 0;
+}
+
+/*
+ * After some hibernation restores on GC 11.5.0 one of the MES pipes stops
+ * at instruction 0 or 1 although the PSP accepted the firmware: either the
+ * scheduler pipe never starts, or the KIQ pipe dies before its ring test.
+ * Bringing MES up again from a fresh PSP load recovers it, where giving up
+ * leaves the GPU wedged after a mode-2 reset.
+ */
+static int mes_v11_0_kiq_hw_init(struct amdgpu_device *adev, uint32_t xcc_id)
+{
+	struct amdgpu_ring *kiq_ring = &adev->gfx.kiq[0].ring;
+	int r, tries;
+
+	for (tries = 1; ; tries++) {
+		r = mes_v11_0_kiq_start(adev);
+		if (r != -ETIMEDOUT || tries > 3 || !adev->in_suspend ||
+		    adev->firmware.load_type != AMDGPU_FW_LOAD_PSP)
+			return r;
+
+		dev_warn(adev->dev,
+			 "MES did not come up, reloading its firmware (retry %d)\n",
+			 tries);
+		mes_v11_0_enable(adev, false);
+		kiq_ring->wptr = 0;
+		*kiq_ring->wptr_cpu_addr = 0;
+		*kiq_ring->rptr_cpu_addr = 0;
+		amdgpu_ring_clear_ring(kiq_ring);
+		r = mes_v11_0_psp_reload(adev);
+		if (r) {
+			dev_err(adev->dev, "MES firmware reload failed (%d)\n", r);
+			return r;
+		}
+	}
+}
+
 static int mes_v11_0_kiq_hw_fini(struct amdgpu_device *adev, uint32_t xcc_id)
 {
 	if (adev->mes.ring[0].sched.ready) {
