From c98b7d6f47904f8001b76830d39a86eadf5ea698 Mon Sep 17 00:00:00 2001
From: John Rinehart <johnrichardrinehart@gmail.com>
Date: Mon, 28 Sep 2026 11:39:01 -0400
Subject: [PATCH] spicy: don't replace a settings file the user cannot write

spicy saves its settings on exit with g_file_set_contents(), which
writes a new file and renames it over the old one. That succeeds
whatever the permissions of the settings file itself, so a read-only
~/.config/spicy/settings, or a symlink to a read-only file as
configuration managers such as Home Manager install, is silently
replaced on every exit by a regular file holding whatever the session
had in memory.

Treat a settings file the user cannot write as one spicy must not
change, and skip the save. A missing file is still created as before.

Signed-off-by: John Rinehart <johnrichardrinehart@gmail.com>
---
 tools/spicy.c | 14 +++++++++++---
 1 file changed, 11 insertions(+), 3 deletions(-)

diff --git a/tools/spicy.c b/tools/spicy.c
index dd58cae..391c750 100644
--- a/tools/spicy.c
+++ b/tools/spicy.c
@@ -18,6 +18,7 @@
 
 #include "config.h"
 #include <glib.h>
+#include <glib/gstdio.h>
 
 #include <sys/stat.h>
 #ifdef HAVE_TERMIOS_H
@@ -2011,7 +2012,7 @@ int main(int argc, char *argv[])
     GError *error = NULL;
     GOptionContext *context;
     spice_connection *conn;
-    gchar *conf_file, *conf;
+    gchar *conf_file, *conf = NULL;
     char *host = NULL, *port = NULL, *tls_port = NULL, *unix_path = NULL;
 
     keyfile = g_key_file_new();
@@ -2079,8 +2080,15 @@ int main(int argc, char *argv[])
         g_main_loop_run(mainloop);
     g_main_loop_unref(mainloop);
 
-    if ((conf = g_key_file_to_data(keyfile, NULL, &error)) == NULL ||
-        !g_file_set_contents(conf_file, conf, -1, &error)) {
+    /* g_file_set_contents() renames a new file over the old one, so it
+     * would replace a read-only settings file, or a symlink to one such as
+     * a configuration manager installs, just as readily as a writable one.
+     * A settings file the user cannot write is one they do not want spicy
+     * to change: leave it alone. */
+    if (g_access(conf_file, W_OK) != 0 && errno != ENOENT) {
+        SPICE_DEBUG("Not saving configuration: %s is not writable", conf_file);
+    } else if ((conf = g_key_file_to_data(keyfile, NULL, &error)) == NULL ||
+               !g_file_set_contents(conf_file, conf, -1, &error)) {
         SPICE_DEBUG("Couldn't save configuration: %s", error->message);
         g_error_free(error);
         error = NULL;
-- 
