From 5e1ccb21f10c685aba0302c5a4d00e79366b77c6 Mon Sep 17 00:00:00 2001
From: John Rinehart <johnrichardrinehart@gmail.com>
Date: Mon, 23 Nov 2026 12:24:38 -0500
Subject: [PATCH] ConnectionNotifier: take back Disconnected when the device
 returns within 30 seconds

---
 blueman/plugins/applet/ConnectionNotifier.py | 25 +++++++++++++++++---
 1 file changed, 22 insertions(+), 3 deletions(-)

diff --git a/blueman/plugins/applet/ConnectionNotifier.py b/blueman/plugins/applet/ConnectionNotifier.py
index 1deae45..a32fed9 100644
--- a/blueman/plugins/applet/ConnectionNotifier.py
+++ b/blueman/plugins/applet/ConnectionNotifier.py
@@ -1,6 +1,6 @@
 import logging
 from gettext import gettext as _
-from typing import Any, Dict, Union
+from typing import Any, Dict, Tuple, Union
 
 from blueman.bluez.Device import Device
 from blueman.gui.Notification import Notification, _NotificationBubble, _NotificationDialog
@@ -14,9 +14,15 @@ class ConnectionNotifier(AppletPlugin):
     __icon__ = "bluetooth-symbolic"
     __description__ = _("Shows desktop notifications when devices get connected or disconnected.")
 
+    # A device that comes back within this many seconds of dropping out takes
+    # its Disconnected notification back and gets no Connected notification.
+    RECONNECT_GRACE_SECONDS = 30
+
     _notifications: Dict[str, Union[_NotificationBubble, _NotificationDialog]] = {}
 
     def on_load(self) -> None:
+        # Disconnected notification and monotonic time of the disconnect, per device.
+        self._disconnects: Dict[str, Tuple[Union[_NotificationBubble, _NotificationDialog], int]] = {}
         self._battery_watcher = BatteryWatcher(self._on_battery_update)
 
     def on_unload(self) -> None:
@@ -26,6 +32,16 @@ class ConnectionNotifier(AppletPlugin):
         if key == "Connected":
             device = Device(obj_path=path)
             if value:
+                disconnect = self._disconnects.pop(path, None)
+                if disconnect is not None:
+                    disconnected, since = disconnect
+                    if GLib.get_monotonic_time() - since < self.RECONNECT_GRACE_SECONDS * 1_000_000:
+                        try:
+                            disconnected.close()
+                        except GLib.Error:
+                            # The notification server already closed it.
+                            pass
+                        return
                 self._notifications[path] = notification = Notification(
                     device.display_name,
                     _('Connected'),
@@ -34,12 +50,15 @@ class ConnectionNotifier(AppletPlugin):
                 )
                 notification.show()
             else:
-                Notification(
+                self._notifications.pop(path, None)
+                notification = Notification(
                     device.display_name,
                     _('Disconnected'),
                     icon_name=device["Icon"],
                     transient=True,
-                ).show()
+                )
+                notification.show()
+                self._disconnects[path] = (notification, GLib.get_monotonic_time())
 
     def _on_battery_update(self, path: str, value: int) -> None:
         notification = self._notifications.pop(path, None)
