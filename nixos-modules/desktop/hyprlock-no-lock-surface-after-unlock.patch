hyprlock: do not create a lock surface after the unlock

releaseSessionLock() drops the session lock but leaves m_lockAquired set,
so an output that appears while hyprlock exits (a monitor turned off and on
again after resume) takes the "lock acquired" path and dereferences the null
lock in CSessionLockSurface: SIGSEGV in sendGetLockSurface.

diff --git a/src/core/Output.cpp b/src/core/Output.cpp
--- a/src/core/Output.cpp
+++ b/src/core/Output.cpp
@@ -56,6 +56,13 @@
         return;
     }
 
+    // An output can appear after the unlock, e.g. a monitor that is turned
+    // off and on again while hyprlock exits. The lock object is gone then.
+    if (!g_pHyprlock->getSessionLock()) {
+        Log::logger->log(Log::WARN, "output {}: no session lock, not creating a lock surface", m_ID);
+        return;
+    }
+
     m_sessionLockSurface = makeUnique<CSessionLockSurface>(m_self.lock());
 }
 
diff --git a/src/core/hyprlock.cpp b/src/core/hyprlock.cpp
--- a/src/core/hyprlock.cpp
+++ b/src/core/hyprlock.cpp
@@ -814,6 +814,7 @@
 
     m_sLockState.lock->sendUnlockAndDestroy();
     m_sLockState.lock = nullptr;
+    m_lockAquired     = false;
 
     Log::logger->log(Log::INFO, "Unlocked, exiting!");
 
