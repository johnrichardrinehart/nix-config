From 83dffc122ffa36c1260351e7b4b6ab367beabb55 Mon Sep 17 00:00:00 2001
From: John Rinehart <johnrichardrinehart@gmail.com>
Date: Wed, 21 Oct 2026 22:15:27 -0400
Subject: [PATCH] niri: pin smithay master and the drm-extras fork

Niri main already pins smithay to the Smithay master tip. The late-CRTC
mapping fix for smithay-drm-extras is not in Smithay yet
(Smithay/smithay#2125).

Take smithay-drm-extras from the fork branch that carries the late-CRTC
mapping fix, rebased onto the same Smithay master tip.
---
 Cargo.lock | 2 +-
 Cargo.toml | 4 ++--
 2 files changed, 3 insertions(+), 3 deletions(-)

diff --git a/Cargo.lock b/Cargo.lock
index 5a0e00c5..8fb81cd3 100644
--- a/Cargo.lock
+++ b/Cargo.lock
@@ -3335,7 +3335,7 @@ dependencies = [
 [[package]]
 name = "smithay-drm-extras"
 version = "0.1.0"
-source = "git+https://github.com/Smithay/smithay.git?rev=65aa86fa5236e41775c313408102a5d5c2d1e2ca#65aa86fa5236e41775c313408102a5d5c2d1e2ca"
+source = "git+https://github.com/johnrichardrinehart/smithay.git?rev=234408fcbb49ca3485d5147bf1e7d2aa8fe41daf#234408fcbb49ca3485d5147bf1e7d2aa8fe41daf"
 dependencies = [
  "drm",
  "libdisplay-info",
diff --git a/Cargo.toml b/Cargo.toml
index 3146c659..fbc6a43e 100644
--- a/Cargo.toml
+++ b/Cargo.toml
@@ -33,8 +33,8 @@ default-features = false
 
 [workspace.dependencies.smithay-drm-extras]
 # version = "0.1.0"
-git = "https://github.com/Smithay/smithay.git"
-rev = "65aa86fa5236e41775c313408102a5d5c2d1e2ca"
+git = "https://github.com/johnrichardrinehart/smithay.git"
+rev = "234408fcbb49ca3485d5147bf1e7d2aa8fe41daf"
 # path = "../smithay/smithay-drm-extras"
 
 [package]
-- 
2.56.0

