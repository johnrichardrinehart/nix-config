         self.ipc_keyboard_layouts_changed();
     }
 
-    /// Returns the configured keymap as XKB_KEYMAP_FORMAT_TEXT_V1.
+    /// Returns the configured Smithay keymap file.
     fn configured_keymap(&mut self) -> KeymapFile {
         if let Some(keymap) = &self.niri.configured_keymap {
             return keymap.clone();
diff --git a/src/handlers/xdg_shell.rs b/src/handlers/xdg_shell.rs
index 4e6c4891..42c2b167 100644
--- a/src/handlers/xdg_shell.rs
+++ b/src/handlers/xdg_shell.rs
@@ -1016,6 +1016,22 @@ impl XdgDecorationHandler for State {
         }
     }
 
+    fn decoration_destroyed(&mut self, toplevel: ToplevelSurface) {
+        // The client destroyed its decoration object, so it draws its own decorations again.
+        toplevel.with_pending_state(|state| {
+            state.decoration_mode = None;
+        });
+
+        if toplevel.is_initial_configure_sent() {
+            let surface = toplevel.wl_surface();
+            if let Some((mapped, _)) = self.niri.layout.find_window_and_output_mut(surface) {
+                mapped.set_needs_configure();
+            } else {
+                toplevel.send_configure();
+            }
+        }
+    }
+
     fn unset_mode(&mut self, toplevel: ToplevelSurface) {
         // If we want CSD, we hide this global altogether.
         toplevel.with_pending_state(|state| {
