--- /dev/null
+++ b/src/input/virtual_keyboard.rs
@@ -0,0 +1,95 @@
+//! Seat keymap handling for `zwp_virtual_keyboard_v1` clients.
+//!
+//! A virtual keyboard sends keycodes and modifier masks that only have meaning in its own keymap.
+//! Niri activates that keymap before it handles the device's events. It restores the configured
+//! keymap before the next non-virtual key, before per-window layout tracking runs, and when the
+//! virtual keyboard goes away.
+
+use std::sync::Arc;
+
+use smithay::backend::input::Device as _;
+use smithay::input::keyboard::Layout;
+use smithay::wayland::virtual_keyboard::VirtualKeyboardDevice;
+
+use crate::niri::State;
+
+/// A virtual keyboard keymap that replaced the configured seat keymap.
+pub struct VirtualKeymap {
+    /// Device ID of the virtual keyboard that activated the keymap.
+    owner: String,
+    keymap: Arc<str>,
+    /// Active layout of the configured keymap when the virtual keymap replaced it.
+    configured_layout: Layout,
+}
+
+impl State {
+    /// Activates the keymap that the keycodes and modifiers of `device` belong to.
+    ///
+    /// Returns `false` if the keymap could not be activated. The device's event must then be
+    /// dropped, because the active keymap would assign it the wrong meaning.
+    pub fn activate_virtual_keymap(&mut self, device: &VirtualKeyboardDevice) -> bool {
+        let Some(keymap) = device.keymap() else {
+            // The device sent `no_keymap`, so its keycodes use the configured keymap.
+            self.restore_configured_keymap();
+            return true;
+        };
+
+        let owner = device.id();
+        if let Some(active) = &mut self.niri.virtual_keymap {
+            if Arc::ptr_eq(&active.keymap, &keymap) || active.keymap == keymap {
+                active.owner = owner;
+                active.keymap = keymap;
+                return true;
+            }
+        }
+
+        let keyboard = self.niri.seat.get_keyboard().unwrap();
+        let configured_layout = match &self.niri.virtual_keymap {
+            Some(active) => active.configured_layout,
+            None => keyboard.with_xkb_state(self, |context| {
+                context.xkb().lock().unwrap().active_layout()
+            }),
+        };
+
+        if let Err(err) = keyboard.set_keymap_from_string(self, keymap.to_string()) {
+            warn!("error activating virtual keyboard keymap: {err:?}");
+            return false;
+        }
+
+        self.niri.virtual_keymap = Some(VirtualKeymap {
+            owner,
+            keymap,
+            configured_layout,
+        });
+        true
+    }
+
+    /// Restores the configured keymap if a virtual keyboard replaced it.
+    pub fn restore_configured_keymap(&mut self) {
+        let Some(virtual_keymap) = self.niri.virtual_keymap.take() else {
+            return;
+        };
+
+        if !self.apply_xkb(self.niri.current_keyboard.xkb.clone()) {
+            return;
+        }
+
+        let keyboard = self.niri.seat.get_keyboard().unwrap();
+        keyboard.with_xkb_state(self, |mut context| {
+            context.set_layout(virtual_keymap.configured_layout);
+        });
+        self.ipc_refresh_keyboard_layout_index();
+    }
+
+    /// Restores the configured keymap if the removed `device` owns the active keymap.
+    pub fn release_virtual_keymap(&mut self, device: &VirtualKeyboardDevice) {
+        if self
+            .niri
+            .virtual_keymap
+            .as_ref()
+            .is_some_and(|active| active.owner == device.id())
+        {
+            self.restore_configured_keymap();
+        }
+    }
+}
