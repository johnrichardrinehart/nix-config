From f81a4a8e7bf9ae591a54beb546243c2f2d82b9f5 Mon Sep 17 00:00:00 2001
From: John Rinehart <johnrichardrinehart@gmail.com>
Date: Wed, 21 Oct 2026 22:15:27 -0400
Subject: [PATCH] niri: pin smithay master and the drm-extras fork

Smithay master has fixes that the pinned Smithay revision lacks. The
late-CRTC mapping fix for smithay-drm-extras is not in Smithay yet
(Smithay/smithay#2125).

Pin smithay to the Smithay master tip. Take smithay-drm-extras from the
fork branch that carries the late-CRTC mapping fix.
---
 Cargo.lock | 6 +++---
 Cargo.toml | 6 +++---
 2 files changed, 6 insertions(+), 6 deletions(-)

diff --git a/Cargo.lock b/Cargo.lock
index 1c1d4ef3..043de367 100644
--- a/Cargo.lock
+++ b/Cargo.lock
@@ -3396,7 +3396,7 @@ checksum = "e8e2fb0f499abb4d162f2bedad68f5ef91a1682b5a03596ddb67efd37768d100"
 [[package]]
 name = "smithay"
 version = "0.7.0"
-source = "git+https://github.com/Smithay/smithay.git?rev=8a270232f1bfc416c781273c98a3f52a812a0bba#8a270232f1bfc416c781273c98a3f52a812a0bba"
+source = "git+https://github.com/Smithay/smithay.git?rev=24647fc8d00131eb7f388efed26e35ea316b0018#24647fc8d00131eb7f388efed26e35ea316b0018"
 dependencies = [
  "aliasable",
  "appendlist",
@@ -3473,7 +3473,7 @@ dependencies = [
 [[package]]
 name = "smithay-drm-extras"
 version = "0.1.0"
-source = "git+https://github.com/Smithay/smithay.git?rev=8a270232f1bfc416c781273c98a3f52a812a0bba#8a270232f1bfc416c781273c98a3f52a812a0bba"
+source = "git+https://github.com/johnrichardrinehart/smithay.git?rev=dce5382714bbbe8954e545168121cd42ad4cfe13#dce5382714bbbe8954e545168121cd42ad4cfe13"
 dependencies = [
  "drm",
  "libdisplay-info",
@@ -3605,7 +3605,7 @@ source = "registry+https://github.com/rust-lang/crates.io-index"
 checksum = "32497e9a4c7b38532efcdebeef879707aa9f794296a4f0244f6f69e9bc8574bd"
 dependencies = [
  "fastrand",
- "getrandom 0.4.3",
+ "getrandom 0.3.4",
  "once_cell",
  "rustix 1.1.4",
  "windows-sys 0.61.2",
diff --git a/Cargo.toml b/Cargo.toml
index b7d70b00..e2db4a0d 100644
--- a/Cargo.toml
+++ b/Cargo.toml
@@ -28,13 +28,13 @@ tracy-client = { version = "0.18.5", default-features = false }
 [workspace.dependencies.smithay]
 # version = "0.4.1"
 git = "https://github.com/Smithay/smithay.git"
-rev = "8a270232f1bfc416c781273c98a3f52a812a0bba"
+rev = "24647fc8d00131eb7f388efed26e35ea316b0018"
 default-features = false
 
 [workspace.dependencies.smithay-drm-extras]
 # version = "0.1.0"
-git = "https://github.com/Smithay/smithay.git"
-rev = "8a270232f1bfc416c781273c98a3f52a812a0bba"
+git = "https://github.com/johnrichardrinehart/smithay.git"
+rev = "dce5382714bbbe8954e545168121cd42ad4cfe13"
 # path = "../smithay/smithay-drm-extras"
 
 [package]
