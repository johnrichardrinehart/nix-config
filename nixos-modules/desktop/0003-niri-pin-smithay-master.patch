From 1de287e82a67c5896d8bd3b76f11c936b78c98cf Mon Sep 17 00:00:00 2001
From: John Rinehart <johnrichardrinehart@gmail.com>
Date: Wed, 21 Oct 2026 22:15:27 -0400
Subject: [PATCH] niri: pin smithay master and the drm-extras fork

Smithay master has fixes that the pinned Smithay revision lacks. The
late-CRTC mapping fix for smithay-drm-extras is not in Smithay yet
(Smithay/smithay#2125).

Pin smithay to the Smithay master tip. Take smithay-drm-extras from the
fork branch that carries the late-CRTC mapping fix.
---
 Cargo.lock                       |  4 ++--
 Cargo.toml                       |  6 +++---
 src/handlers/virtual_keyboard.rs |  6 +++---
 src/handlers/xdg_shell.rs        | 16 ++++++++++++++++
 4 files changed, 24 insertions(+), 8 deletions(-)

diff --git a/Cargo.lock b/Cargo.lock
index 5a0e00c5..577e1b73 100644
--- a/Cargo.lock
+++ b/Cargo.lock
@@ -3258,7 +3258,7 @@ checksum = "e8e2fb0f499abb4d162f2bedad68f5ef91a1682b5a03596ddb67efd37768d100"
 [[package]]
 name = "smithay"
 version = "0.7.0"
-source = "git+https://github.com/Smithay/smithay.git?rev=65aa86fa5236e41775c313408102a5d5c2d1e2ca#65aa86fa5236e41775c313408102a5d5c2d1e2ca"
+source = "git+https://github.com/Smithay/smithay.git?rev=a38bb709a0400759b6a4fab6129e0f1dd72808c3#a38bb709a0400759b6a4fab6129e0f1dd72808c3"
 dependencies = [
  "aliasable",
  "appendlist",
@@ -3335,7 +3335,7 @@ dependencies = [
 [[package]]
 name = "smithay-drm-extras"
 version = "0.1.0"
-source = "git+https://github.com/Smithay/smithay.git?rev=65aa86fa5236e41775c313408102a5d5c2d1e2ca#65aa86fa5236e41775c313408102a5d5c2d1e2ca"
+source = "git+https://github.com/johnrichardrinehart/smithay.git?rev=daeff4ead091360c9b7c03e0f3f029364a1f6401#daeff4ead091360c9b7c03e0f3f029364a1f6401"
 dependencies = [
  "drm",
  "libdisplay-info",
diff --git a/Cargo.toml b/Cargo.toml
index 3146c659..b25d7c5c 100644
--- a/Cargo.toml
+++ b/Cargo.toml
@@ -28,13 +28,13 @@ tracy-client = { version = "0.18.5", default-features = false }
 [workspace.dependencies.smithay]
 # version = "0.4.1"
 git = "https://github.com/Smithay/smithay.git"
-rev = "65aa86fa5236e41775c313408102a5d5c2d1e2ca"
+rev = "a38bb709a0400759b6a4fab6129e0f1dd72808c3"
 default-features = false
 
 [workspace.dependencies.smithay-drm-extras]
 # version = "0.1.0"
-git = "https://github.com/Smithay/smithay.git"
-rev = "65aa86fa5236e41775c313408102a5d5c2d1e2ca"
+git = "https://github.com/johnrichardrinehart/smithay.git"
+rev = "daeff4ead091360c9b7c03e0f3f029364a1f6401"
 # path = "../smithay/smithay-drm-extras"
 
 [package]
diff --git a/src/handlers/virtual_keyboard.rs b/src/handlers/virtual_keyboard.rs
index 8757f1e4..0ca1e295 100644
--- a/src/handlers/virtual_keyboard.rs
+++ b/src/handlers/virtual_keyboard.rs
@@ -199,8 +199,8 @@ impl State {
 
