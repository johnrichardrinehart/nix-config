 pub struct Input {
     pub keyboard: Keyboard,
+    pub keyboard_overrides: Vec<KeyboardPart>,
     pub touchpad: Touchpad,
     pub mouse: Mouse,
     pub trackpoint: Trackpoint,
@@ -25,10 +26,28 @@ pub struct Input {
     pub mod_key_nested: Option<ModKey>,
 }
 
+impl Input {
+    pub fn keyboard_for_device(&self, device_name: &str) -> Keyboard {
+        let mut keyboard = self.keyboard.clone();
+
+        for config in &self.keyboard_overrides {
+            if config
+                .name
+                .as_deref()
+                .is_some_and(|name| name.eq_ignore_ascii_case(device_name))
+            {
+                keyboard.merge_with(config);
+            }
+        }
+
+        keyboard
+    }
+}
+
 #[derive(knuffel::Decode, Debug, Default, PartialEq)]
 pub struct InputPart {
-    #[knuffel(child)]
-    pub keyboard: Option<KeyboardPart>,
+    #[knuffel(children(name = "keyboard"))]
+    pub keyboards: Vec<KeyboardPart>,
     #[knuffel(child)]
     pub touchpad: Option<Touchpad>,
     #[knuffel(child)]
@@ -57,9 +76,16 @@ pub struct InputPart {
 
 impl MergeWith<InputPart> for Input {
     fn merge_with(&mut self, part: &InputPart) {
+        for keyboard in &part.keyboards {
+            if keyboard.name.is_some() {
+                self.keyboard_overrides.push(keyboard.clone());
+            } else {
+                self.keyboard.merge_with(keyboard);
+            }
+        }
+
         merge!(
             (self, part),
-            keyboard,
             disable_power_key_handling,
             workspace_auto_back_and_forth,
         );
