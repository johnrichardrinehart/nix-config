+        let matched = config.input.keyboard_for_device("SLICEMK ERGODOX KEYBOARD");
+        assert_eq!(matched.repeat_delay, 300);
+        assert_eq!(matched.repeat_rate, 40);
+        assert_eq!(matched.xkb.layout, "us");
+        assert_eq!(matched.xkb.variant, "");
+
+        let unmatched = config
+            .input
+            .keyboard_for_device("AT Translated Set 2 keyboard");
+        assert_eq!(unmatched, *default);
+    }
