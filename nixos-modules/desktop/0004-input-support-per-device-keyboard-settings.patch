+    /// Switches to the keyboard settings of the physical keyboard `device`.
+    fn apply_keyboard_config<I: InputBackend>(&mut self, device: &I::Device)
+    where
+        I::Device: 'static,
+    {
+        let input_device = (device as &dyn Any)
+            .downcast_ref::<input::Device>()
+            .cloned();
+
+        if input_device.as_ref() == self.niri.active_keyboard_device.as_ref() {
+            return;
+        }
+
+        let keyboard_config = if let Some(input_device) = &input_device {
+            if let Some(cached) = self.niri.keyboard_device_cache.get(input_device) {
+                cached.clone()
+            } else {
+                let keyboard_config = self
+                    .niri
+                    .config
+                    .borrow()
+                    .input
+                    .keyboard_for_device(&device.name());
+                self.niri
+                    .keyboard_device_cache
+                    .insert(input_device.clone(), keyboard_config.clone());
+                keyboard_config
+            }
+        } else {
+            self.niri.config.borrow().input.keyboard.clone()
+        };
+        if self.set_keyboard_config(keyboard_config) {
+            self.niri.active_keyboard_device = input_device;
+        }
+    }
+
     fn start_key_repeat(&mut self, bind: Bind) {
