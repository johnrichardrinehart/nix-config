     }
 
+    fn apply_keyboard_config<I: InputBackend>(&mut self, event: &I::KeyboardKeyEvent)
+    where
+        I::Device: 'static,
+    {
+        let device = event.device();
+        let input_device = (&device as &dyn Any)
+            .downcast_ref::<input::Device>()
+            .cloned();
+
+        if input_device.as_ref() == self.niri.active_keyboard_device.as_ref() {
+            return;
+        }
+
+        let keyboard_config = if let Some(input_device) = &input_device {
+            if let Some(cached) = self.niri.keyboard_device_cache.get(input_device) {
+                cached.clone()
+            } else {
+                let keyboard_config = self
+                    .niri
+                    .config
+                    .borrow()
+                    .input
+                    .keyboard_for_device(&device.name());
+                self.niri
+                    .keyboard_device_cache
+                    .insert(input_device.clone(), keyboard_config.clone());
+                keyboard_config
+            }
+        } else {
+            self.niri.config.borrow().input.keyboard.clone()
+        };
+        if keyboard_config == self.niri.current_keyboard {
+            self.niri.active_keyboard_device = input_device;
+            return;
+        }
+
+        let current_keyboard = self.niri.current_keyboard.clone();
+        if keyboard_config.xkb != current_keyboard.xkb {
+            if !self.apply_xkb(keyboard_config.xkb.clone()) {
+                return;
+            }
+            self.ipc_keyboard_layouts_changed();
+        }
+
+        let keyboard = self.niri.seat.get_keyboard().unwrap();
+        if keyboard_config.repeat_rate != current_keyboard.repeat_rate
+            || keyboard_config.repeat_delay != current_keyboard.repeat_delay
+        {
+            keyboard.change_repeat_info(
+                keyboard_config.repeat_rate.into(),
+                keyboard_config.repeat_delay.into(),
+            );
+        }
+
+        if keyboard_config.numlock != current_keyboard.numlock {
+            let mut modifier_state = keyboard.modifier_state();
+            modifier_state.num_lock = keyboard_config.numlock;
+            keyboard.set_modifier_state(modifier_state);
+        }
+
+        self.niri.current_keyboard = keyboard_config;
+        self.niri.active_keyboard_device = input_device;
+    }
+
     fn start_key_repeat(&mut self, bind: Bind) {
         if !bind.repeat {
             return;
