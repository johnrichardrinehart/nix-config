+    fn per_device_keyboard_config() {
+        let config = do_parse(
+            r#"
+            input {
+                keyboard {
+                    repeat-delay 500
+                    repeat-rate 30
+                    xkb {
+                        layout "us"
+                        variant "dvorak"
+                    }
+                }
+                keyboard "SliceMK ErgoDox Keyboard" {
