+    #[test]
+    fn per_device_keyboard_config() {
+        let config = do_parse(
+            r#"
+            input {
+                keyboard {
+                    repeat-delay 500
+                    repeat-rate 30
+                    xkb {
+                        layout "us"
+                        variant "dvorak"
+                    }
+                }
+                keyboard "SliceMK ErgoDox Keyboard" {
+                    repeat-rate 40
+                    xkb {
+                        layout "us"
+                    }
+                }
+                keyboard "slicemk ergodox keyboard" {
+                    repeat-delay 300
+                }
+            }
+            "#,
+        );
+
+        let default = &config.input.keyboard;
+        assert_eq!(default.repeat_delay, 500);
+        assert_eq!(default.repeat_rate, 30);
+        assert_eq!(default.xkb.variant, "dvorak");
+
+        let matched = config.input.keyboard_for_device("SLICEMK ERGODOX KEYBOARD");
+        assert_eq!(matched.repeat_delay, 300);
+        assert_eq!(matched.repeat_rate, 40);
+        assert_eq!(matched.xkb.layout, "us");
+        assert_eq!(matched.xkb.variant, "");
+
+        let unmatched = config
+            .input
+            .keyboard_for_device("AT Translated Set 2 keyboard");
+        assert_eq!(unmatched, *default);
+    }
