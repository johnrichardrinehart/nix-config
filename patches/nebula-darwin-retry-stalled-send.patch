--- a/udp/udp_darwin.go
+++ b/udp/udp_darwin.go
@@ -17,6 +17,12 @@
 	"golang.org/x/sys/unix"
 )
 
+// Total time, in milliseconds, that one send waits for a stalled socket before it drops the datagram.
+const (
+	sendStallBudgetMs = 10
+	sendStallStepMs   = 2
+)
+
 type StdConn struct {
 	*net.UDPConn
 	isV4  bool
@@ -114,6 +120,7 @@
 
 	// Golang stdlib doesn't handle EAGAIN correctly in some situations so we do writes ourselves
 	// See https://github.com/golang/go/issues/73919
+	waited := 0
 	for {
 		//_, _, err := unix.Syscall6(unix.SYS_SENDTO, u.sysFd, uintptr(unsafe.Pointer(&b[0])), uintptr(len(b)), 0, sa, addrLen)
 		err := sendto(int(u.sysFd), b, 0, sa, addrLen)
@@ -127,7 +134,16 @@
 			continue
 		}
 
-		if errors.Is(err, syscall.EAGAIN) {
+		if errors.Is(err, syscall.EAGAIN) || errors.Is(err, syscall.ENOBUFS) {
+			// The send can stall briefly, for example while the EndpointSecurity send check is
+			// throttled (slackhq/nebula#1901). Wait for writability within a short budget, then
+			// drop. Never wait in the netpoller without a deadline (golang/go#73919).
+			if waited < sendStallBudgetMs {
+				fds := []unix.PollFd{{Fd: int32(u.sysFd), Events: unix.POLLOUT}}
+				_, _ = unix.Poll(fds, sendStallStepMs)
+				waited += sendStallStepMs
+				continue
+			}
 			return &net.OpError{Op: "sendto", Err: unix.EWOULDBLOCK}
 		}
 
