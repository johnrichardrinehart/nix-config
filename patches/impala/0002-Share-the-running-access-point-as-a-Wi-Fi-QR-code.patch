diff --git a/src/handler.rs b/src/handler.rs
index 9eb0873..5a5e2c6 100644
--- a/src/handler.rs
+++ b/src/handler.rs
@@ -647,8 +647,33 @@ pub async fn handle_key_events(
                             app.focused_block = FocusedBlock::Device;
                         }
                     }
+                    FocusedBlock::ShareNetwork => {
+                        if key_event.code == KeyCode::Esc {
+                            ap.share = None;
+                            app.focused_block = FocusedBlock::AccessPoint;
+                        }
+                    }
                     _ => {
                         match key_event.code {
+                            // Share; ahead of the plain `q` quit
+                            KeyCode::Char(c)
+                                if c == config.ap.share
+                                    && key_event.modifiers == KeyModifiers::CONTROL =>
+                            {
+                                if app.focused_block == FocusedBlock::AccessPoint {
+                                    match ap.share() {
+                                        Ok(share) => {
+                                            ap.share = Some(share);
+                                            app.focused_block = FocusedBlock::ShareNetwork;
+                                        }
+                                        Err(e) => Notification::send(
+                                            e.to_string(),
+                                            notification::NotificationLevel::Error,
+                                            &sender,
+                                        )?,
+                                    }
+                                }
+                            }
                             KeyCode::Char('q') => {
                                 app.quit();
                             }
