+    /// QR code for the running access point. A passphrase typed into the
+    /// new-AP popup for this SSID is used as is; otherwise the AP was started
+    /// from its iwd profile, which only root can read.
+    pub fn share(&self) -> Result<Share> {
+        let ssid = self
+            .name
+            .clone()
+            .filter(|_| self.has_started)
+            .context("The access point is not started")?;
+
+        if !self.psk.value().is_empty() && self.ssid.value() == ssid {
+            return Share::from_credentials(ssid, self.psk.value().to_string(), false);
+        }
+
+        if unsafe { libc::geteuid() } != 0 {
+            anyhow::bail!("impala must be run as root to share an access point profile");
+        }
+
+        Share::from_ap_profile(ssid)
+    }
+
     pub fn render_input(&self, frame: &mut Frame, config: Arc<Config>) {
         let popup_layout = Layout::default()
             .direction(Direction::Vertical)
@@ -602,16 +626,24 @@ impl AccessPoint {
                 Span::from(config.ap.stop.to_string()).bold(),
                 Span::from(" Stop AP"),
                 Span::from(" | "),
+                Span::from(format!("ctrl+{}", config.ap.share)).bold(),
+                Span::from(" Share"),
+                Span::from(" | "),
                 Span::from("ctrl+r").bold(),
                 Span::from(" Switch Mode"),
                 Span::from(" | "),
                 tab,
                 Span::from(" Nav"),
             ]),
+            FocusedBlock::ShareNetwork => Line::from(vec![esc, Span::from(" Close")]),
             _ => Line::from(""),
         };
 
         let help_message = help_message.centered().blue();
         frame.render_widget(help_message, help_block);
+
+        if let Some(share) = &self.share {
+            share.render(frame, config.clone());
+        }
     }
 }
