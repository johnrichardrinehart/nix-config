--- a/src/mode/station/share.rs
+++ b/src/mode/station/share.rs
@@ -1,4 +1,4 @@
-use anyhow::Result;
+use anyhow::{Context, Result};
 use qrcode::QrCode;
 use std::{cmp, fs, sync::Arc};
 use tui_qrcode::{Colors, QrCodeWidget};
@@ -30,6 +30,15 @@ fn get_escaped_wifi_value(value: &str) -> String {
         .replace(':', r"\:")
 }
 
+// QrCode is not Debug; also keeps the passphrase out of debug output.
+impl std::fmt::Debug for Share {
+    fn fmt(&self, f: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {
+        f.debug_struct("Share")
+            .field("network_name", &self.network_name)
+            .finish_non_exhaustive()
+    }
+}
+
 impl Share {
     pub fn new(network_name: String) -> Result<Self> {
         let encoded_network_name = iwd_network_name(&network_name);
@@ -40,22 +49,46 @@ impl Share {
             .find(|&line| line.starts_with("Passphrase="))
             && let Some((_, passphrase)) = line.split_once('=')
         {
-            let message = format!(
-                "WIFI:T:WPA;S:{};P:{};;",
-                get_escaped_wifi_value(&network_name),
-                get_escaped_wifi_value(passphrase),
-            );
-            let qr_code = QrCode::new(message)?;
-            Ok(Self {
-                qr_code,
-                network_name,
-                passphrase: passphrase.to_string(),
-            })
+            Self::from_credentials(network_name, passphrase.to_string(), false)
         } else {
             unreachable!()
         }
     }
 
+    /// Reads the iwd access point profile (iwd.ap(5)) named `ssid`. iwd keeps
+    /// profiles under their raw SSID, root-only.
+    pub fn from_ap_profile(ssid: String) -> Result<Self> {
+        let content = fs::read_to_string(format!("/var/lib/iwd/ap/{}.ap", ssid))?;
+        let value = |key: &str| {
+            content
+                .lines()
+                .find_map(|line| line.trim().strip_prefix(key)?.trim().strip_prefix('='))
+                .map(str::trim)
+        };
+
+        let passphrase = value("Passphrase")
+            .context("The access point profile has no Passphrase to share")?
+            .to_string();
+        let hidden = value("Hidden") == Some("true");
+
+        Self::from_credentials(ssid, passphrase, hidden)
+    }
+
+    pub fn from_credentials(network_name: String, passphrase: String, hidden: bool) -> Result<Self> {
+        let message = format!(
+            "WIFI:T:WPA;S:{};P:{};{};",
+            get_escaped_wifi_value(&network_name),
+            get_escaped_wifi_value(&passphrase),
+            if hidden { "H:true;" } else { "" },
+        );
+        let qr_code = QrCode::new(message)?;
+        Ok(Self {
+            qr_code,
+            network_name,
+            passphrase,
+        })
+    }
+
     pub fn render(&self, frame: &mut Frame, config: Arc<Config>) {
         let widget = QrCodeWidget::new(self.qr_code.clone()).colors(Colors::Inverted);
         let sim_area = Rect::new(0, 0, 50, 50);
