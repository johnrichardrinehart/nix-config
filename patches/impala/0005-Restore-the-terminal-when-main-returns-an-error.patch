From 8af829cd836b03e87107b8e814c79fed905278f5 Mon Sep 17 00:00:00 2001
From: John Rinehart <johnrichardrinehart@gmail.com>
Date: Sun, 1 Nov 2026 16:57:10 -0500
Subject: [PATCH 5/5] Restore the terminal when main returns an error

Several errors after Tui::init(), for example an unknown --mode or a
failed draw, return from main with `?` and skip Tui::exit(). The shell
then gets back a terminal in raw mode, on the alternate screen, with
mouse capture on and the cursor hidden. Typed text does not echo, and
the next impala run saves that raw mode as the mode to restore on exit.

Tui now restores the terminal when it is dropped, unless exit() has
already done so.
---
 src/tui.rs | 21 ++++++++++++++++++++-
 1 file changed, 20 insertions(+), 1 deletion(-)

diff --git a/src/tui.rs b/src/tui.rs
index 7551b98..f6bd0ae 100644
--- a/src/tui.rs
+++ b/src/tui.rs
@@ -18,11 +18,17 @@ use std::panic;
 pub struct Tui<B: Backend> {
     terminal: Terminal<B>,
     pub events: EventHandler,
+    // Raw mode is on and exit() has not restored the terminal yet.
+    active: bool,
 }
 
 impl<B: Backend> Tui<B> {
     pub fn new(terminal: Terminal<B>, events: EventHandler) -> Self {
-        Self { terminal, events }
+        Self {
+            terminal,
+            events,
+            active: false,
+        }
     }
 
     pub fn init(&mut self) -> Result<()>
@@ -31,6 +37,7 @@ impl<B: Backend> Tui<B> {
         <B as Backend>::Error: 'static,
     {
         terminal::enable_raw_mode()?;
+        self.active = true;
         ratatui::crossterm::execute!(io::stdout(), EnterAlternateScreen, EnableMouseCapture)?;
 
         let panic_hook = panic::take_hook();
@@ -71,6 +78,18 @@ impl<B: Backend> Tui<B> {
     {
         Self::reset()?;
         self.terminal.show_cursor()?;
+        self.active = false;
         Ok(())
     }
 }
+
+// main() returns errors with `?` before it reaches exit(). Without this, the
+// shell gets back a terminal in raw mode: no echo, no output processing.
+impl<B: Backend> Drop for Tui<B> {
+    fn drop(&mut self) {
+        if self.active {
+            let _ = Self::reset();
+            let _ = self.terminal.show_cursor();
+        }
+    }
+}
