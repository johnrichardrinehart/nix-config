@@ -45,7 +45,7 @@ impl App {
     pub async fn new(
         sender: UnboundedSender<Event>,
         config: Arc<Config>,
-        mode: Mode,
+        mode: Option<Mode>,
     ) -> Result<Self> {
         let session = {
             match iwdrs::session::Session::new().await {
@@ -67,8 +67,16 @@ Error: {}",
             }
         };
 
-        let device = Device::new(session.clone()).await?;
-        device.set_mode(mode).await?;
+        let mut device = Device::new(session.clone()).await?;
+
+        // Only switch when asked to, and only when it changes anything:
+        // switching tears down a running access point or station connection.
+        if let Some(mode) = mode
+            && mode != device.mode
+        {
+            device.set_mode(mode).await?;
+            device = Device::new(session.clone()).await?;
+        }
 
         let agent = AuthAgent::new(sender);
         let _ = session.register_agent(agent.clone()).await?;
@@ -82,7 +90,7 @@ Error: {}",
             FocusedBlock::Device
         };
 
-        let reset = Reset::new(mode);
+        let reset = Reset::new(device.mode);
 
         Ok(Self {
             running: true,
