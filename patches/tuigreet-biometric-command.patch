@@ -43,6 +43,23 @@ pub async fn handle(
 ) -> Result<(), Box<dyn Error>> {
   let mut greeter = greeter.write().await;
 
+  // Alt+F (Super+Alt+F on the Linux console) starts the biometric command instead
+  // of typing the letter. It also works while PAM waits for a biometric
+  // factor, so check it before the busy state.
+  if let KeyEvent {
+    code: KeyCode::Char('f' | 'F'),
+    modifiers,
+    ..
+  } = input
+    && modifiers.contains(KeyModifiers::ALT)
+    && greeter.biometric_command.is_some()
+  {
+    if matches!(greeter.mode, Mode::Username | Mode::Password | Mode::Action) {
+      run_biometric_command(&greeter);
+    }
+    return Ok(());
+  }
+
   if greeter.working {
     return Ok(());
   }
@@ -415,6 +432,29 @@ pub async fn handle(
   Ok(())
 }
 
+// Run the biometric command for the user in the background. Its output would
+// corrupt the terminal UI, so discard it.
+fn run_biometric_command(greeter: &Greeter) {
+  let Some(command) = greeter.biometric_command.as_deref() else {
+    return;
+  };
+  let mut args = command.split(' ');
+  let mut command = std::process::Command::new(args.next().unwrap_or_default());
+  command
+    .args(args)
+    .arg(&greeter.username.value)
+    .stdin(std::process::Stdio::null())
+    .stdout(std::process::Stdio::null())
+    .stderr(std::process::Stdio::null());
+
+  match command.spawn() {
+    Ok(mut child) => {
+      std::thread::spawn(move || child.wait());
+    },
+    Err(err) => tracing::warn!("could not start the biometric command: {err}"),
+  }
+}
