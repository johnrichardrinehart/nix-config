+  #[tokio::test]
+  async fn alt_f_runs_biometric_command_instead_of_typing() {
+    let greeter = Arc::new(RwLock::new(Greeter::default()));
+
+    {
+      let mut greeter = greeter.write().await;
+      greeter.mode = Mode::Password;
+      greeter.buffer = "secret".to_string();
+    }
+
+    let _ = handle(
+      greeter.clone(),
+      KeyEvent::new(KeyCode::Char('f'), KeyModifiers::ALT),
+      Ipc::new(),
+    )
+    .await;
+
+    assert_eq!(greeter.read().await.buffer, "secretf");
+
+    {
+      let mut greeter = greeter.write().await;
+      greeter.buffer = "secret".to_string();
+      greeter.biometric_command = Some("true".to_string());
+    }
+
+    for modifiers in [KeyModifiers::ALT, KeyModifiers::ALT | KeyModifiers::SHIFT] {
+      let result = handle(
+        greeter.clone(),
+        KeyEvent::new(KeyCode::Char('f'), modifiers),
+        Ipc::new(),
+      )
+      .await;
+
+      assert!(matches!(result, Ok(())));
+      assert_eq!(greeter.read().await.buffer, "secret");
+    }
+  }
+
+  #[tokio::test]
+  async fn alt_f_runs_biometric_command_while_pam_waits() {
+    let marker = std::env::temp_dir().join(format!(
+      "tuigreet-biometric-{}",
+      std::process::id()
+    ));
+    let _ = std::fs::remove_file(&marker);
+
+    let greeter = Arc::new(RwLock::new(Greeter::default()));
+
+    {
+      let mut greeter = greeter.write().await;
+      greeter.mode = Mode::Action;
+      greeter.working = true;
+      greeter.username =
+        MaskedString::from(marker.to_string_lossy().into_owned(), None);
+      greeter.biometric_command = Some("touch".to_string());
+    }
+
+    let result = handle(
+      greeter.clone(),
+      KeyEvent::new(KeyCode::Char('f'), KeyModifiers::ALT),
+      Ipc::new(),
+    )
+    .await;
+    assert!(matches!(result, Ok(())));
+
+    for _ in 0..50 {
+      if marker.exists() {
+        break;
+      }
+      tokio::time::sleep(std::time::Duration::from_millis(20)).await;
+    }
+    assert!(marker.exists());
+    let _ = std::fs::remove_file(&marker);
+  }
