From 2594f720d62277001a05ebc5fbd0931732d75fea Mon Sep 17 00:00:00 2001
From: John Rinehart <johnrichardrinehart@gmail.com>
Date: Thu, 29 Oct 2026 12:54:55 -0400
Subject: [PATCH 5/6] wiphy: Add wiphy_get_vht_capabilities

Return the body of a VHT Capabilities element for a band, combining
the kernel's VHT capability and VHT MCS set attributes, like
wiphy_get_ht_capabilities does for HT.
---
 src/wiphy.c | 20 ++++++++++++++++++++
 src/wiphy.h |  3 +++
 2 files changed, 23 insertions(+)

diff --git a/src/wiphy.c b/src/wiphy.c
index b6774f69..77866f89 100644
--- a/src/wiphy.c
+++ b/src/wiphy.c
@@ -1019,6 +1019,26 @@ const uint8_t *wiphy_get_ht_capabilities(const struct wiphy *wiphy,
 	return ht_capa;
 }
 
+const uint8_t *wiphy_get_vht_capabilities(const struct wiphy *wiphy,
+						enum band_freq band,
+						size_t *size)
+{
+	static uint8_t vht_capa[12];
+	const struct band *bandp = wiphy_get_band(wiphy, band);
+
+	if (!bandp || !bandp->vht_supported)
+		return NULL;
+
+	/* VHT Capabilities Information followed by Supported VHT-MCS Set */
+	memcpy(vht_capa, bandp->vht_capabilities, 4);
+	memcpy(vht_capa + 4, bandp->vht_mcs_set, 8);
+
+	if (size)
+		*size = sizeof(vht_capa);
+
+	return vht_capa;
+}
+
 int wiphy_estimate_data_rate(struct wiphy *wiphy,
 				const void *ies, uint16_t ies_len,
 				const struct scan_bss *bss,
diff --git a/src/wiphy.h b/src/wiphy.h
index 19d79405..1e7bf6ab 100644
--- a/src/wiphy.h
+++ b/src/wiphy.h
@@ -149,6 +149,9 @@ bool wiphy_supports_colocated_flag(const struct wiphy *wiphy);
 const uint8_t *wiphy_get_ht_capabilities(const struct wiphy *wiphy,
 						enum band_freq band,
 						size_t *size);
+const uint8_t *wiphy_get_vht_capabilities(const struct wiphy *wiphy,
+						enum band_freq band,
+						size_t *size);
 void wiphy_generate_random_address(struct wiphy *wiphy, uint8_t addr[static 6]);
 void wiphy_generate_address_from_ssid(struct wiphy *wiphy,
 					const uint8_t *ssid, size_t ssid_len,
