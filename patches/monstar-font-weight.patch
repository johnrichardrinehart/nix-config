diff --git a/src/Font.zig b/src/Font.zig
index b8a5ecd..1f871c1 100644
--- a/src/Font.zig
+++ b/src/Font.zig
@@ -92,9 +92,12 @@ pub const FaceStyle = enum(u2) {
         else if (italic) .italic else .regular;
     }
 
-    fn weight(self: FaceStyle) ?c_int {
+    fn weight(self: FaceStyle, configured: Config.FontWeight) ?c_int {
         return switch (self) {
-            .regular, .italic => null,
+            .regular, .italic => switch (configured) {
+                .default => null,
+                .medium => c.FC_WEIGHT_MEDIUM,
+            },
             .bold, .bold_italic => c.FC_WEIGHT_BOLD,
         };
     }
@@ -107,8 +110,20 @@ pub const FaceStyle = enum(u2) {
     }
 };
 
+test "select configured regular and bold emphasized weights" {
+    try std.testing.expectEqual(null, FaceStyle.regular.weight(.default));
+    try std.testing.expectEqual(c.FC_WEIGHT_MEDIUM, FaceStyle.regular.weight(.medium).?);
+    try std.testing.expectEqual(c.FC_WEIGHT_MEDIUM, FaceStyle.italic.weight(.medium).?);
+    try std.testing.expectEqual(c.FC_WEIGHT_BOLD, FaceStyle.bold.weight(.default).?);
+    try std.testing.expectEqual(c.FC_WEIGHT_BOLD, FaceStyle.bold_italic.weight(.default).?);
+}
+
 const style_count = std.enums.values(FaceStyle).len;
 
+pub const Options = struct {
+    weight: Config.FontWeight = .default,
+};
+
 /// Fontconfig results shared by every rasterizer at one size. Rasterizers
 /// need independent FreeType, HarfBuzz, and glyph-cache state, but can share
 /// these read-only candidate lists instead of repeating font discovery.
@@ -121,6 +136,7 @@ pub const Discovery = struct {
     family: [:0]u8,
     size_px: f64,
     adjustments: Config.MetricAdjustments,
+    options: Options,
     /// Best match per style; immutable after initialization.
     primary_patterns: [style_count]*c.FcPattern,
     /// Lazily built fallback lists; null until first use. Written once
@@ -132,6 +148,7 @@ pub const Discovery = struct {
         family: [:0]const u8,
         size_px: f64,
         adjustments: Config.MetricAdjustments,
+        options: Options,
     ) Error!*Discovery {
         if (c.FcInit() != c.FcTrue) return error.FontLoadFailed;
 
@@ -142,7 +159,7 @@ pub const Discovery = struct {
             }
         }
         inline for (comptime std.enums.values(FaceStyle)) |style| {
-            patterns_opt[@backingInt(style)] = try fontMatch(family, size_px, style);
+            patterns_opt[@backingInt(style)] = try fontMatch(family, size_px, style, options);
         }
         var patterns: [style_count]*c.FcPattern = undefined;
         for (patterns_opt, 0..) |pattern, i| patterns[i] = pattern.?;
@@ -156,6 +173,7 @@ pub const Discovery = struct {
             .family = family_copy,
             .size_px = size_px,
             .adjustments = adjustments,
+            .options = options,
             .primary_patterns = patterns,
             .sort_sets = @splat(.init(null)),
             .sort_mutex = .unlocked,
@@ -172,7 +190,7 @@ pub const Discovery = struct {
         while (!self.sort_mutex.tryLock()) std.Thread.yield() catch {};
         defer self.sort_mutex.unlock();
         if (slot.load(.acquire)) |set| return set;
-        const set = fontSort(self.family, self.size_px, style) catch |err| {
+        const set = fontSort(self.family, self.size_px, style, self.options) catch |err| {
             log.warn("fallback font list for {} unavailable: {}", .{ style, err });
             return null;
         };
@@ -770,13 +788,13 @@ fn bitmapRow(bitmap: c.FT_Bitmap, height: u31, y: usize) usize {
     return if (bitmap.pitch < 0) height - 1 - y else y;
 }
 
-fn stylePattern(family: [:0]const u8, size_px: f64, style: FaceStyle) Error!*c.FcPattern {
+fn stylePattern(family: [:0]const u8, size_px: f64, style: FaceStyle, options: Options) Error!*c.FcPattern {
     const pattern = c.FcPatternCreate() orelse return error.FontLoadFailed;
     errdefer c.FcPatternDestroy(pattern);
     _ = c.FcPatternAddString(pattern, c.FC_FAMILY, family.ptr);
     _ = c.FcPatternAddDouble(pattern, c.FC_PIXEL_SIZE, size_px);
     _ = c.FcPatternAddInteger(pattern, c.FC_SPACING, c.FC_MONO);
-    if (style.weight()) |weight| _ = c.FcPatternAddInteger(pattern, c.FC_WEIGHT, weight);
+    if (style.weight(options.weight)) |weight| _ = c.FcPatternAddInteger(pattern, c.FC_WEIGHT, weight);
     if (style.slant()) |slant| _ = c.FcPatternAddInteger(pattern, c.FC_SLANT, slant);
     if (c.FcConfigSubstitute(null, pattern, c.FcMatchPattern) != c.FcTrue)
         return error.FontLoadFailed;
@@ -786,8 +804,8 @@ fn stylePattern(family: [:0]const u8, size_px: f64, style: FaceStyle) Error!*c.F
 
 /// The best match alone: the same candidate a sort would rank first, at a
 /// fraction of the cost because nothing is sorted or trimmed.
-fn fontMatch(family: [:0]const u8, size_px: f64, style: FaceStyle) Error!*c.FcPattern {
-    const pattern = try stylePattern(family, size_px, style);
+fn fontMatch(family: [:0]const u8, size_px: f64, style: FaceStyle, options: Options) Error!*c.FcPattern {
+    const pattern = try stylePattern(family, size_px, style, options);
     defer c.FcPatternDestroy(pattern);
     var result: c.FcResult = undefined;
     const match = c.FcFontMatch(null, pattern, &result) orelse return error.FontNotFound;
@@ -798,8 +816,8 @@ fn fontMatch(family: [:0]const u8, size_px: f64, style: FaceStyle) Error!*c.FcPa
     return match;
 }
 
-fn fontSort(family: [:0]const u8, size_px: f64, style: FaceStyle) Error!*c.FcFontSet {
-    const pattern = try stylePattern(family, size_px, style);
+fn fontSort(family: [:0]const u8, size_px: f64, style: FaceStyle, options: Options) Error!*c.FcFontSet {
+    const pattern = try stylePattern(family, size_px, style, options);
     defer c.FcPatternDestroy(pattern);
 
     var result: c.FcResult = undefined;
@@ -852,10 +870,20 @@ pub fn init(
     family: [:0]const u8,
     size_px: f64,
     adjustments: Config.MetricAdjustments,
+) Error!Font {
+    return initOptions(alloc, family, size_px, adjustments, .{});
+}
+
+pub fn initOptions(
+    alloc: std.mem.Allocator,
+    family: [:0]const u8,
+    size_px: f64,
+    adjustments: Config.MetricAdjustments,
+    options: Options,
 ) Error!Font {
     std.debug.assert(size_px > 0);
 
-    const discovery_data = try Discovery.init(family, size_px, adjustments);
+    const discovery_data = try Discovery.init(family, size_px, adjustments, options);
     defer discovery_data.unref();
     return initWithDiscovery(alloc, discovery_data);
 }
